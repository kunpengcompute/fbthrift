[manifest]
name = cmake

[homebrew]
cmake

# 18.04 cmake is too old
[debs.not(all(distro=ubuntu,distro_vers="18.04"))]
cmake

[rpms]
cmake

[dependencies]
ninja

[download.os=windows]
