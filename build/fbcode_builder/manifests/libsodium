[manifest]
name = libsodium

[debs]
libsodium-dev

[homebrew]
libsodium

[rpms]
libsodium-devel
libsodium-static

[download.not(os=windows)]
# 1.0.17 GitHub release assets were removed; use 1.0.18 (same autoconf layout).
url = https://github.com/jedisct1/libsodium/releases/download/1.0.18-RELEASE/libsodium-1.0.18.tar.gz
sha256 = 6f504490b342a4f8a4c4a02fc9b866cbef8622d5df4e5452b46be121e46636c1

[build.not(os=windows)]
builder = autoconf
subdir = libsodium-1.0.18

[download.os=windows]
# Official download.libsodium.org no longer hosts 1.0.17 MSVC zip; use GitHub release.
url = https://github.com/jedisct1/libsodium/releases/download/1.0.18-RELEASE/libsodium-1.0.18-msvc.zip
sha256 = c1d48d85c9361e350931ffe5067559cd7405a697c655d26955fb568d1084a5f4

[build.os=windows]
builder = nop

[install.files.os=windows]
x64/Release/v141/dynamic/libsodium.dll = bin/libsodium.dll
x64/Release/v141/dynamic/libsodium.lib = lib/libsodium.lib
x64/Release/v141/dynamic/libsodium.exp = lib/libsodium.exp
x64/Release/v141/dynamic/libsodium.pdb = lib/libsodium.pdb
include = include

[autoconf.args]
