+  uint32_t written = 0;
+  svbool_t pt = svptrue_b8();
+  svuint32_t dep_mask = svdup_u32(0x7F7F7F7Fu);
+  alignas(16) static const uint32_t TAG_TABLE[8] = {
+      0u, 0u, 0x80u, 0x8080u, 0x808080u, 0x80808080u, 0u, 0u};
+  alignas(16) static const uint32_t EXT_TABLE[8] = {
