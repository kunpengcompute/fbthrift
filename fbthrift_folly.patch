+template <class T>
+uint32_t varintEncode32SveKernel(
+    const T* loc, uint32_t size, folly::io::QueueAppender& out) {
+  static_assert(
+      std::is_same<T, int32_t>::value || std::is_same<T, uint32_t>::value,
