+    backend = result.get();
+    return result;
+  });
+  folly::EventBase evb(options);
+  int consumed = 0;
+  Queue queue(evb, Consumer{[&](int) { ++consumed; }}, true);
+  queue.startConsumingInternal(&evb);
+  prime(evb);
+  const int previous = backend->breaks;
+  queue.putMessage(1);
+  queue.execute();
+  queue.putMessage(2);
+  queue.drain();
+  EXPECT_EQ(consumed, 2);
+  EXPECT_EQ(backend->breaks, previous);
+}
